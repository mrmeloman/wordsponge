{
  "manifest_version": 3,
  "name": "Word Sponge",
  "version": "1.3",
  "description": "Word Sponge helps you learn a new language by integrating that language into your daily life.",
  "minimum_chrome_version": "121",
  "permissions": [
    "storage",
    "alarms",
    "activeTab"
  ],
  "optional_host_permissions": [
    "https://thewordsponge.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Word Sponge",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["*://*.google.com/*","*://*.twitter.com/*"],
      "js": ["frequency.js", "content.js"],
      "css": ["style.css"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "wordsponge@thewordsponge.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
